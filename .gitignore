# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

dist-electron/
AI_CONTEXT.md

# build/ is generated output (icons, file-type icons, AppX tiles, Store art) EXCEPT the NSIS
# script. `build/*` rather than `build/` so git still descends into the directory and the negation
# below can take effect (git does not traverse an excluded directory).
build/*

# The NSIS installer script is hand-authored build SOURCE, not a generated artifact. Without it
# `npm run electron:build` cannot produce an installer at all, so a clone needs it.
!build/installer.nsh

# The AppStream metadata for the Linux packages (.deb/.rpm), hand-authored source as well.
!build/com.vaguedustin.fate.metainfo.xml

# The .deb/.rpm maintainer scripts (they register and remove the apt/dnf repositories) and the
# package-signing PUBLIC keyring, fate-archive-keyring.{asc,gpg}, which the packages ship and CI
# checks the signing key against. Source too.
!build/linux/

# Snap: snap/snapcraft.yaml is source; snap/gui/ is generated by scripts/write-snap-desktop.mjs,
# snapbuild/ is the staging directory the workflow builds in, *.snap is output.
snap/gui/
snap/.snapcraft/
snapbuild/
*.snap

# Flatpak: flatpak/com.vaguedustin.fate.yml is the template; rendered copies are generated.
flatpak/rendered/
.flatpak-builder/

# Icon artwork masters. build/ is ignored (generated), but these are the sources
# scripts/generate-icons.mjs derives everything from, so they must be tracked.
!brand/

# AUR build artifacts
aur/src/
aur/pkg/
aur/deb/
aur/root/
aur/*.deb
aur/*.pkg.tar.*
aur/LICENSE-*

# Package build outputs & archives
*.AppImage
*.deb
*.rpm
*.pkg.tar.*
*.zip

# Temporary & scratch files
.scratch/
scratch/
*.tmp

